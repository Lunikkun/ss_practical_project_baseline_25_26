# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=documents

# Upload Configuration
MAX_UPLOAD_BYTES=10485760

# Authentication & Security
LOGIN_IP_RATE_LIMIT=50
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_DURATION=300

# HTTPS & Session Hardening
FORCE_HTTPS=0
HSTS_MAX_AGE=31536000
APP_SECURITY_PROFILE=dev
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax

# Upload Rate Limiting
UPLOAD_RATE_LIMIT=25
UPLOAD_RATE_WINDOW=60

# Storage Quotas
USER_MAX_FILES=0
USER_STORAGE_QUOTA_BYTES=0
GLOBAL_STORAGE_QUOTA_BYTES=0
MIN_FREE_DISK_BYTES=10485760

# Secret Key (set in CI/CD or production with strong value)
SECRET_KEY=dev-key-not-for-production-change-in-prod
